<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Android TV / Google TV uiMode-specific foreground.
      The launcher owns the final circular mask; this inset only controls how
      much breathing room the artwork has inside that adaptive-icon canvas.
    -->
    <item
        android:left="28dp"
        android:top="28dp"
        android:right="28dp"
        android:bottom="28dp">
        <bitmap
            android:src="@drawable/ic_launcher_foreground"
            android:gravity="fill" />
    </item>
</layer-list>
