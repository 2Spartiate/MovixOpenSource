<?xml version="1.0" encoding="utf-8"?>
<!--
  Session-1 launcher banner derived only from the existing Movix Android icon.
  A final localized 320x180 raster banner can replace this resource later
  without changing the manifest contract.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A0A0A" />
        </shape>
    </item>
    <item
        android:width="72dp"
        android:height="72dp"
        android:gravity="center">
        <bitmap
            android:src="@mipmap/ic_launcher"
            android:gravity="fill" />
    </item>
</layer-list>
